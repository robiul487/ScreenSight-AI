# GEMINI_API_KEY: Optional build-time fallback for emulator / development convenience.
# SECURITY WARNING: Values injected into BuildConfig via .env are compiled into the APK bytecode
# and are NOT secure if the APK is distributed or shared publicly.
# For user devices, enter the API key at runtime inside the app so it is encrypted on-device
# with Android Keystore (AES-256-GCM) rather than embedded in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY
